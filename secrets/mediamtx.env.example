# Copy to secrets/mediamtx.env (chmod 600). Never commit the real file.
# One line per camera: MTX_PATHS_<STREAM_PATH upper-cased>_SOURCE=<rtsp url with credentials>
# The stream path must match Camera.stream_path (lowercase letters/digits only).
MTX_PATHS_ENTRANCE_SOURCE=rtsp://USERNAME:PASSWORD@192.168.1.50:8080/h264_aac.sdp
