# Copy to .env and replace every CHANGE_ME value:  cp .env.example .env && chmod 600 .env
# Generate secrets with:  scripts/generate-secrets.sh

# --- Django -----------------------------------------------------------------
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_DEBUG=0
# Hostnames/IPs you type into the browser (comma separated).
DJANGO_ALLOWED_HOSTS=192.168.1.10,cctv.lan,localhost
# Full origins incl. scheme and port, needed for login (CSRF) when using a non-default port.
DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.1.10:8080,http://cctv.lan:8080,http://localhost:8080
# Set to 1 only when served over HTTPS (e.g. Tailscale serve). Plain-HTTP LAN must stay 0.
DJANGO_SECURE_COOKIES=0
DJANGO_LOG_LEVEL=INFO
# Fernet key used to encrypt camera credentials stored via Django admin.
CCTV_FIELD_ENCRYPTION_KEY=CHANGE_ME

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=cctv
POSTGRES_USER=cctv
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Host paths and ports ---------------------------------------------------
# Existing recorder output on the Ubuntu host. Mounted READ-ONLY.
CCTV_HOST_RECORDINGS_DIR=/home/sunil/cctv/recordings
# UID/GID of the user that owns the recordings (run `id -u sunil` / `id -g sunil`).
APP_UID=1000
APP_GID=1000
# Web UI listen address/port on the host. 0.0.0.0 = whole LAN.
CCTV_HTTP_BIND=0.0.0.0
CCTV_HTTP_PORT=8080
# MediaMTX RTSP re-stream, bound to localhost only (for testing / future recorder switch).
MEDIAMTX_RTSP_HOST_PORT=8554

# --- Application tuning -----------------------------------------------------
TZ=Asia/Kolkata
# Seconds between recording index runs.
CCTV_SYNC_INTERVAL=300
# Upper bound for remuxed MP4 cache (bytes). 20 GiB default.
CCTV_PLAYBACK_CACHE_MAX_BYTES=21474836480
# Rewrite MP4 index to the front (slower remux, slightly faster first play). 0/1
CCTV_PLAYBACK_FASTSTART=0
GUNICORN_WORKERS=2
GUNICORN_THREADS=4

# --- Docker networks ----------------------------------------------------------
# Pinned so Docker never picks a range that overlaps your LAN (e.g. iPhone hotspot 172.20.10.0/28).
CCTV_BACKEND_SUBNET=10.89.1.0/24
CCTV_FRONTEND_SUBNET=10.89.2.0/24
